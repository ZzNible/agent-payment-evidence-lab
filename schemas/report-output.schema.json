{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apel:schema:scenario-report-output:0.1",
  "title": "Example paid API output",
  "description": "The deliberately small expected-result schema used by the executable scenarios to distinguish a successful HTTP response from a schema-valid deliverable.",
  "type": "object",
  "required": [
    "status",
    "data"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "data": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
